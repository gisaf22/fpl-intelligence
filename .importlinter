[importlinter]
root_packages =
    dal
    domain
    research
    model
    serve
    decisions

[importlinter:contract:no_domain_to_anything]
name = Domain is the shared leaf — must import nothing project-internal
type = forbidden
source_modules =
    domain
forbidden_modules =
    dal
    research
    model
    serve

[importlinter:contract:no_research_to_downstream]
name = Research must not import from downstream layers
type = forbidden
source_modules =
    research
forbidden_modules =
    model
    serve

[importlinter:contract:no_serve_to_research_or_model]
name = Intelligence must not import from research or model
type = forbidden
source_modules =
    serve
forbidden_modules =
    research
    model

[importlinter:contract:no_diagnostic_to_predictive_layers]
name = Diagnostic (Rung 2) must not import predictive/operational research layers
type = forbidden
source_modules =
    research.diagnostic
forbidden_modules =
    research.families
    research.findings

[importlinter:contract:no_model_to_research_analysis]
name = Model must not import research analysis or findings (kernels exempt)
type = forbidden
source_modules =
    model
forbidden_modules =
    research.foundation
    research.diagnostic
    research.families
    research.findings

[importlinter:contract:no_dal_to_system_layers]
name = DAL must not import from system layers
type = forbidden
source_modules =
    dal
forbidden_modules =
    research
    model
    serve

# The starting_xi slice's two-tier contract (decisions/starting_xi/DESIGN.md 3.9). It must be
# written per-module: the package as a whole has to be allowed to import `model` for the Tier B
# ranker edge, while every Tier A module must not.
#
# All seven slice modules now exist, so the two rules earlier passes had to defer -- Tier A must not
# import a Tier B module, and Tier B must not import a Tier A one -- are written below rather than
# left to the subprocess import-closure tests. import-linter fails on a source or forbidden module
# that is not in the graph, which is the only reason they were deferred.
#
# What still cannot be a `forbidden` contract, and stays enforced by a subprocess test:
#
# * `operational` is not a root package (INVENTORY.md 2.11), so no contract can name it. Both Tier B
#   modules' closure tests assert it is unreached.
# * `formations` is tighter than the shared contract: DESIGN.md 5.1 forbids it `dal` and *every*
#   sibling slice module. The `dal` half is a second contract below -- it cannot join the shared
#   one, which `sampler` legitimately violates. The Tier B half is covered by the Tier A -> Tier B
#   contract; `formations` -> `sampler` / `harness` / `results` is not expressible without
#   forbidding those modules to the other Tier A sources, which 5.1 permits, so it stays in
#   decisions/starting_xi/test_formations.py.
# * `results` needs neither `dal` nor `model` (DESIGN.md 7.8). That is a claim about the module's
#   shape rather than an entry in 5.1's forbidden column, so it is not written as a contract; the
#   subprocess test in test_results.py enforces both halves and carries a falsification case
#   proving the same probe fails against a module that does reach `dal`.
# * `harness` cannot join the `dal` contract below: 5.1 permits it the mart, and 5.3.1's `build` is
#   the call site that reads it.

[importlinter:contract:no_starting_xi_tier_a_to_downstream]
name = starting_xi Tier A must not import model, research or serve
type = forbidden
source_modules =
    decisions.starting_xi.formations
    decisions.starting_xi.sampler
    decisions.starting_xi.harness
    decisions.starting_xi.results
    decisions.starting_xi.orderings
forbidden_modules =
    model
    research
    serve

[importlinter:contract:no_starting_xi_formations_to_dal]
name = starting_xi formations must not import dal
type = forbidden
source_modules =
    decisions.starting_xi.formations
forbidden_modules =
    dal

[importlinter:contract:no_layers_to_decisions]
name = A decision slice is a consumer -- no layer may import one
type = forbidden
source_modules =
    dal
    domain
    research
    model
    serve
forbidden_modules =
    decisions

# DESIGN.md 5.1 forbids `rankers` and `uncertainty` to every Tier A module -- `harness` receives a
# ranking function and never imports one, which is the single absent edge 3.6's transitivity
# guarantee rests on.
[importlinter:contract:no_starting_xi_tier_a_to_tier_b]
name = starting_xi Tier A must not import a Tier B module
type = forbidden
source_modules =
    decisions.starting_xi.formations
    decisions.starting_xi.sampler
    decisions.starting_xi.harness
    decisions.starting_xi.results
    decisions.starting_xi.orderings
forbidden_modules =
    decisions.starting_xi.rankers
    decisions.starting_xi.uncertainty

# DESIGN.md 3.3 defines the two tiers exhaustively: Tier B's permitted list is `model`, `dal` and
# `domain`, so `research` and `serve` are admitted to neither tier (3.9 records why that exclusion
# is deliberate rather than an oversight), and 3.3 forbids Tier B from being imported by Tier A --
# which makes importing a Tier A sibling forbidden in this direction too.
[importlinter:contract:no_starting_xi_tier_b_to_tier_a_or_downstream]
name = starting_xi Tier B may import model, dal and domain -- not research, serve or a Tier A sibling
type = forbidden
source_modules =
    decisions.starting_xi.rankers
    decisions.starting_xi.uncertainty
forbidden_modules =
    research
    serve
    decisions.starting_xi.formations
    decisions.starting_xi.sampler
    decisions.starting_xi.harness
    decisions.starting_xi.results
    decisions.starting_xi.orderings
